# Build OS Radio — environment
#
# Copy to .env.local for development. In production set these in the Vercel
# project (Settings -> Environment Variables). Never commit real values.

# ---------------------------------------------------------------- required

# ElevenLabs. Server-side only; this value must never reach the browser or
# GitHub. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# The two MVP voices. Copy the ids from https://elevenlabs.io/app/voice-library
# (open a voice -> ID). An episode spec can override these per speaker.
ELEVENLABS_HOST_VOICE_ID=
ELEVENLABS_GUEST_VOICE_ID=

# Shared secret between the GitHub Action and this deployment, and used by the
# job runner to call itself. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# There is no sign-in password: the browser side of this app is open by design
# (single owner). This secret protects the machine endpoints only.
INTERNAL_GENERATION_SECRET=

# ---------------------------------------------------------------- storage

# Operational state. Local development needs nothing: the default is a file
# database. For production use Turso: libsql://<db>-<org>.turso.io
DATABASE_URL=file:./data/build-os-radio.db
DATABASE_AUTH_TOKEN=

# Finished audio. Set by Vercel automatically when a Blob store is linked;
# leaving it empty locally makes the app write to data/media instead.
BLOB_READ_WRITE_TOKEN=
# Force a driver: "vercel-blob" or "local". Defaults by whether the token is set.
# MEDIA_STORE_DRIVER=

# ---------------------------------------------------------------- GitHub

# owner/repo. When set, episode specs are read live through the GitHub API so a
# spec edit takes effect without redeploying. Unset falls back to the files that
# shipped with the deployment.
GITHUB_REPO=
GITHUB_BRANCH=main
# Only needed for a private repository; read-only contents scope is enough.
GITHUB_TOKEN=
# Only needed if you use the webhook (option B) instead of the Action (option A).
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- runtime

# Absolute URL of this deployment. Vercel provides VERCEL_URL automatically;
# set this when you have a custom domain, so job continuation calls hit it.
# APP_BASE_URL=https://radio.example.com

# Set by Vercel when you enable Cron; lets the sweeper authenticate.
# CRON_SECRET=

# ------------------------------------------------------- cost and safety
#
# Every number below is a planning value, not billing truth. Defaults are
# calibrated to ~17,000 characters = ~20 minutes = ~$1.70.

# ELEVENLABS_USD_PER_1K_CHARS=0.1
# RUNTIME_CHARS_PER_SECOND=14.2
# RUNTIME_WORDS_PER_MINUTE=136

# Chunking limits (characters per ElevenLabs request).
# MAX_CHARS_PER_CHUNK=2000
# MIN_CHARS_PER_CHUNK=400

# Hard spend guards. A job over either ceiling is refused, never trimmed.
# MAX_EPISODE_CHARACTERS=30000
# MAX_ESTIMATED_COST_USD=3
# MAX_ATTEMPTS_PER_CHUNK=3
# MAX_REQUESTS_PER_JOB=60

# How long one serverless invocation works before handing the job to the next.
# Keep it comfortably below your plan's function timeout.
# INVOCATION_BUDGET_MS=45000
# JOB_LEASE_MS=300000

# Renderer settings.
# ELEVENLABS_MODEL_ID=eleven_v3
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_TIMEOUT_MS=120000

# Additional voices for future roles: ELEVENLABS_VOICE_<SPEAKER_KEY>
# ELEVENLABS_VOICE_HISTORIAN=
